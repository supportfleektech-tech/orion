# ---------------------------------------------------------------- core
APP_NAME=ORION
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000

# SQLite works out of the box. For scale use Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg://orion:orion@postgres:5432/orion
DATABASE_URL=sqlite:////data/orion.db
KNOWLEDGE_DIR=/knowledge

# ------------------------------------------------------- local inference
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
# Set by ./scripts/setup-local-model.sh based on your hardware.
# qwen3.5:4b is the 8GB sweet spot (multimodal, 256K context, tool calling).
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
LOCAL_ONLY=false

# ------------------------------------------------------------ cloud burst
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
CLOUD_ESCALATION_ENABLED=true
OFFLINE_FALLBACK_ENABLED=true

# ------------------------------------------------------------ agent loop
MAX_TOOL_LOOPS=6
MAX_CONTEXT_CHUNKS=8
MAX_HISTORY_MESSAGES=20
MEMORY_SIMILARITY_MIN=0.25

# ----------------------------------------------------- multimodal + learning
# Model-name substrings treated as vision-capable. Attachments are sent as
# images only when the active model matches one of these.
VISION_MODELS=qwen3.5,qwen3-vl,qwen2.5vl,gemma3,llava,minicpm-v,llama3.2-vision,moondream
# faster-whisper size for local audio transcription (tiny|base|small|medium).
WHISPER_MODEL=base
MAX_UPLOAD_MB=25
# Distil successful multi-step runs into reusable skills. Costs one extra local
# model call per learnable run.
SKILL_LEARNING_ENABLED=true

# ----------------------------------------------------------------- tools
ENABLE_WEB_SEARCH=false
ALLOW_NETWORK_TOOL=false
ALLOW_SHELL_TOOL=false
ALLOW_BROWSER_TOOL=false
SEARXNG_BASE_URL=http://searxng:8080
HTTP_ALLOWLIST=

# -------------------------------------------------------------- security
AUTH_ENABLED=false
ADMIN_TOKEN=change-me-before-exposing-this-service
JWT_SECRET=replace-me-in-production
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
